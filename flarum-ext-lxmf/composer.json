{
    "name": "preservemygames/lxmf",
    "description": "Username-only registration and optional LXMF profile addresses for Flarum",
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "flarum/core": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "PreserveMyGames\\Lxmf\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "LXMF Auth",
            "category": "feature",
            "icon": {
                "name": "fas fa-network-wired",
                "backgroundColor": "#1b5e20",
                "color": "#fff"
            }
        }
    }
}
